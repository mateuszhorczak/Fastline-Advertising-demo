{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "vars": {
    // CORS: tylko domena demo (origin nie zawiera ścieżki /repo/)
    "NITRO_ALLOWED_ORIGINS": "https://mateuszhorczak.github.io",
    "NITRO_GEMINI_MODEL": "gemini-3.6-flash",
    "NITRO_GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
  },
  // klucz API ustawiany poza repo: `wrangler secret put NITRO_GEMINI_API_KEY`
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
