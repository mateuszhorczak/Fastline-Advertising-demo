# web/.env — adres backendu (publiczny, to nie jest sekret)
VITE_API_URL=http://localhost:3000

# api/.env — tylko lokalnie; na produkcji: `wrangler secret put NITRO_GEMINI_API_KEY`
NITRO_GEMINI_API_KEY=
NITRO_GEMINI_MODEL=gemini-3.8-flash
NITRO_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
NITRO_ALLOWED_ORIGINS=http://localhost:5173
